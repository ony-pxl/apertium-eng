      <e><p><l>inking</l><r>ink<s n="v"/><s n="pres"/><s n="prog"/></r></p></e>
    </pardef>
    <pardef n="s/it__v">
      <e><p><l>it</l><r>it<s n="v"/><s n="pres"/></r></p></e>
      <e><p><l>its</l><r>it<s n="v"/><s n="pres"/></r></p></e>
      <e><p><l>at</l><r>it<s n="v"/><s n="past"/></r></p></e>
      <e><p><l>itting</l><r>it<s n="v"/><s n="pres"/><s n="prog"/></r></p></e>
