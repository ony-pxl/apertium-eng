<?xml version="1.0" encoding="UTF-8"?>
<dictionary>

  <!-- Define the alphabet below. -->
  <alphabet>aAáÁăảạÆbBcCčdDÐeEéèễệfFgGhHiIíjJkKlLmMnNoOóöớpPqQrRsSšştTŢuUúüưvVwWxXyYzZ</alphabet>

  <sdefs>
    <!-- Define symbol definitions within <sdef> here. -->
    <sdef n="n"               c="Noun"/>
    <sdef n="np"              c="Proper noun"/>
    <sdef n="vblex"           c="Verb, lexical"/>
    <sdef n="vbmod"           c="Modal verb"/>
    <sdef n="vaux"            c="Auxiliary verb"/>
    <sdef n="vbser"           c="'To be' verb"/>
    <sdef n="vbhaver"         c="'To have' verb"/>
    <sdef n="cnjsub"          c="Subordinating conjunction"/>
    <sdef n="cnjcoo"          c="Co-ordinating conjunction"/>
    <sdef n="cnjadv"          c="Adverbial conjunction"/>
    <sdef n="pr"              c="Preposition"/>
    <sdef n="adv"             c="Adverb"/>
    <sdef n="ij"              c="Interjection"/>
    <sdef n="adj"             c="Adjective"/>
    <sdef n="prn"             c="Pronoun"/>
    <sdef n="v"               c="Verb"/>

    <sdef n="attr"            c="Attributive"/>
    <sdef n="top"             c="Toponym"/>
    <sdef n="ant"             c="Anthroponym"/>
    <sdef n="cog"             c="Cognomen"/>
    <sdef n="org"             c="Organisation"/>
    <sdef n="al"              c="Altres / misc proper nouns"/>

    <sdef n="pers"            c="Personal pronoun"/>
    <sdef n="ref"             c="Reflexive pronoun"/>
    <sdef n="res"             c="Reciprocal pronoun"/>

    <sdef n="det"             c="Determiner"/>
    <sdef n="pos"             c="Possessive"/>

    <sdef n="p1"              c="1st person"/>
    <sdef n="p2"              c="2nd person"/>
    <sdef n="p3"              c="3rd person"/>

    <sdef n="nt"              c="Neuter"/>
    <sdef n="ut"              c="Utrum"/>
    <sdef n="f"               c="Feminine"/>
    <sdef n="m"               c="Masculine"/>
    <sdef n="un"              c="No gender"/>

    <sdef n="sg"              c="Singular"/>
    <sdef n="du"              c="Dual"/>
    <sdef n="pl"              c="Plural"/>
    <sdef n="sp"              c="Singular / plural"/>

    <sdef n="ind"             c="Indefinite"/>
    <sdef n="def"             c="Definite"/>

    <sdef n="nom"             c="Nominative"/>
    <sdef n="acc"             c="Accusative"/>
    <sdef n="gen"             c="Genitive"/>

    <sdef n="dem"             c="Demonstrative"/>
    <sdef n="itg"             c="Question word / interrogative"/>
    <sdef n="qnt"             c="Quantifier"/>
    <sdef n="neg"             c="Negative"/>
    <sdef n="emph"            c="Emphatic"/>

    <sdef n="inf"             c="Infinitive"/>
    <sdef n="pres"            c="Present"/>
    <sdef n="imp"             c="Imperative"/>
    <sdef n="pret"            c="Preterite"/>
    <sdef n="pp"              c="Perfect participle"/>
    <sdef n="pprs"            c="Present participle"/>
    <sdef n="pasv"            c="Passive"/>
    <sdef n="actv"            c="Active voice"/>
    <sdef n="prog"            c="Progressive"/>
    <sdef n="past"             c="Past"/>
    <sdef n="pstp"             c="Past participle"/>

    <sdef n="will"             c="Will Vaux"/>

    <sdef n="sint"            c="Synthetic (of adjectives)"/>
    <sdef n="pst"             c="Positive"/>
    <sdef n="comp"            c="Comparative"/>
    <sdef n="sup"             c="Superlative"/>

    <sdef n="ord"             c="Ordinal"/>
    <sdef n="acr"             c="Acronym"/>
    <sdef n="unc"             c="Uncountable"/>

    <sdef n="num"             c="Numeral"/>
    <sdef n="sent"            c="Sentence end"/>
    <sdef n="cm"              c="Comma"/>
    <sdef n="apos"            c="Apostrophe"/>
    <sdef n="guio"            c="Dash"/>
    <sdef n="lpar"            c="Left parenthesis"/>
    <sdef n="rpar"            c="Right parenthesis"/>
    <sdef n="lquot"           c="Left quote"/>
    <sdef n="rquot"           c="Right quote"/>

    <sdef n="compound-only-L" c="May only be the left-side of a compound"/>
    <sdef n="compound-R"      c="May be the right-side of a compound, or a full word"/>
  </sdefs>

  <pardefs>
    <!-- Define paradigms within <pardef> here. -->
    <pardef n="numeral">
      <e><re>[0123456789]+</re></e>
    </pardef>
    <pardef n="number">
      <e><par n="numeral"/><p><l></l><r><s n="num"/></r></p></e>
    </pardef>

    <pardef n="num">
      <e><p><l></l><r><s n="num"/></r></p></e>
    </pardef>

    <!-- adjective pardefs -->
    <pardef n="beautiful__adj">
      <e><p><l></l><r><s n="adj"/></r></p></e>
      <e><p><l>ly</l><r><s n="adv"/></r></p></e>
    </pardef>

    <!-- adverb pardefs -->
    <pardef n="every__adv">
      <e><p><l></l><r><s n="adv"/></r></p></e>
    </pardef>

    <!-- auxilliary verb pardefs -->
    <pardef n="will__vaux">
      <e><p><l></l><r><s n="will"/></r></p></e>
    </pardef>

    <!-- conjunction pardefs -->
    <pardef n="and__cnjcoo">
      <e><p><l></l><r><s n="cnjcoo"/></r></p></e>
    </pardef>

    <!-- determiner pardefs -->
    <pardef n="/a__det">
      <e><p><l>a</l><r>a<s n="det"/><s n="ind"/></r></p></e>
      <e><p><l>the</l><r>a<s n="det"/><s n="def"/></r></p></e>
    </pardef>

    <!-- noun pardefs -->
    <pardef n="house__n">
      <e><p><l></l><r><s n="n"/></r></p></e>
      <e><p><l>s</l><r><s n="n"/><s n="pl"/></r></p></e>
      <e><p><l>'s</l><r><s n="n"/><s n="pos"/></r></p></e>
    </pardef>
    <pardef n="fire__n">
      <e><p><l></l><r><s n="n"/></r></p></e>
      <e><p><l>'s</l><r><s n="n"/><s n="pos"/></r></p></e>
    </pardef>
    <pardef n="fish__n">
      <e><p><l></l><r><s n="n"/></r></p></e>
      <e><p><l>es</l><r><s n="n"/><s n="pl"/></r></p></e>
      <e><p><l>'s</l><r><s n="n"/><s n="pos"/></r></p></e>
    </pardef>
    <pardef n="m/an__n">
      <e><p><l>an</l><r>an<s n="n"/></r></p></e>
      <e><p><l>en</l><r>an<s n="n"/><s n="pl"/></r></p></e>
      <e><p><l>an's</l><r><s n="n"/><s n="pos"/></r></p></e>
      <e><p><l>en's</l><r>an<s n="n"/><s n="pl"/><s n="pos"/></r></p></e>
    </pardef>
    <pardef n="wom/an__n">
      <e><p><l>an</l><r>an<s n="n"/></r></p></e>
      <e><p><l>en</l><r>an<s n="n"/><s n="pl"/></r></p></e>
      <e><p><l>an's</l><r><s n="n"/><s n="pos"/></r></p></e>
      <e><p><l>en's</l><r>an<s n="n"/><s n="pl"/><s n="pos"/></r></p></e>
    </pardef>

    <!-- preposition pardefs -->
    <pardef n="on__pr">
      <e><p><l></l><r><s n="pr"/></r></p></e>
    </pardef>

    <!-- pronoun pardefs -->
    <pardef n="/I__prn">
      <e><p><l>I</l><r>I<s n="prn"/><s n="p1"/></r></p></e>
      <e><p><l>mine</l><r>I<s n="prn"/><s n="gen"/><s n="p1"/></r></p></e>
      <e><p><l>myself</l><r>I<s n="prn"/><s n="ref"/><s n="p1"/></r></p></e>
      <e><p><l>my</l><r>I<s n="prn"/><s n="gen"/><s n="p1"/></r></p></e>
    </pardef>
    <pardef n="you__prn">
      <e><p><l></l><r><s n="prn"/><s n="p2"/></r></p></e>
      <e><p><l>r</l><r><s n="prn"/><s n="gen"/><s n="p2"/></r></p></e>
      <e><p><l>rself</l><r><s n="prn"/><s n="ref"/><s n="p2"/></r></p></e>
      <e><p><l>rs</l><r><s n="prn"/><s n="gen"/><s n="p2"/></r></p></e>
    </pardef>
    <pardef n="this__prn">
      <e><p><l></l><r><s n="prn"/></r></p></e>
    </pardef>

    <!-- verb pardefs -->
    <pardef n="walk__v">
      <e><p><l></l><r><s n="v"/><s n="pres"/></r></p></e>
      <e><p><l>s</l><r><s n="v"/><s n="pres"/></r></p></e>
      <e><p><l>ed</l><r><s n="v"/><s n="past"/></r></p></e>
      <e><p><l>ing</l><r><s n="v"/><s n="pres"/><s n="prog"/></r></p></e>
    </pardef>
    <pardef n="d/o__v">
      <e><p><l>o</l><r>o<s n="v"/><s n="pres"/></r></p></e>
      <e><p><l>oes</l><r>o<s n="v"/><s n="pres"/></r></p></e>
      <e><p><l>id</l><r>o<s n="v"/><s n="past"/></r></p></e>
      <e><p><l>one</l><r>o<s n="v"/><s n="pstp"/></r></p></e>
      <e><p><l>oing</l><r>o<s n="v"/><s n="pres"/><s n="prog"/></r></p></e>
      <e><p><l>on't</l><r>o<s n="v"/><s n="pres"/><j/>not<s n="adv"/></r></p></e>
    </pardef>
    <pardef n="love__v">
      <e><p><l></l><r><s n="v"/><s n="pres"/></r></p></e>
    </pardef>
    <pardef n="/eat__v">
      <e><p><l>eat</l><r>eat<s n="v"/><s n="pres"/></r></p></e>
      <e><p><l>eats</l><r>eat<s n="v"/><s n="pres"/></r></p></e>
