    </pardef>
    <pardef n="/be__v">
      <e><p><l>be</l><r>be<s n="v"/></r></p></e>
      <e><p><l>am</l><r>be<s n="v"/><s n="p1"/></r></p></e>
      <e><p><l>is</l><r>be<s n="v"/><s n="sg"/></r></p></e>
      <e><p><l>been</l><r>be<s n="v"/><s n="pstp"/></r></p></e>
      <e><p><l>are</l><r>be<s n="v"/><s n="pl"/></r></p></e>
    </pardef>
    <pardef n="wr/ite__v">
