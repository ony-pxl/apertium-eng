      <e><p><l>iting</l><r>ite<s n="v"/><s n="pres"/><s n="prog"/></r></p></e>
    </pardef>
    <pardef n="/go__v">
      <e><p><l>go</l><r>go<s n="v"/><s n="pres"/></r></p></e>
