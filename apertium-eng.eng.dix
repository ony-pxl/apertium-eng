      <e><p><l>ows</l><r>ow<s n="v"/><s n="pres"/></r></p></e>
      <e><p><l>ew</l><r>ow<s n="v"/><s n="past"/></r></p></e>
      <e><p><l>own</l><r>ow<s n="v"/><s n="pstp"/></r></p></e>
      <e><p><l>owing</l><r>ow<s n="v"/><s n="pres"/><s n="prog"/></r></p></e>
    </pardef>
    <pardef n="read__v">
      <e><p><l></l><r><s n="v"/><s n="pres"/></r></p></e>
      <e><p><l>s</l><r><s n="v"/><s n="pres"/></r></p></e>
      <e><p><l>ing</l><r><s n="v"/><s n="pres"/><s n="prog"/></r></p></e>
