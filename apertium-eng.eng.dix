  <section id="main" type="standard">
    <!-- Define entries within <e> here. -->
    <!-- Example entry:
    <e lm="house"><i>house</i><par n="house__n"/></e>
    -->

    <!-- NUMBER OF WORDS (34) -->

    <!-- Adjectives -->
    <e lm="angry"><i>angry</i><par n="beautiful__adj"/></e>    
    <e lm="beautiful"><i>beautiful</i><par n="beautiful__adj"/></e>
    <e lm="clear"><i>clear</i><par n="beautiful__adj"/></e>
    <e lm="tired"><i>tired</i><par n="beautiful__adj"/></e>
    <e lm="good"><i>good</i><par n="beautiful__adj"/></e>

    <!-- Adverbs -->
    <e lm="every"><i>every</i><par n="every__adv"/></e>
    <e lm="later"><i>later</i><par n="every__adv"/></e>
    <e lm="yesterday"><i>yesterday</i><par n="every__adv"/></e>
    <e lm="now"><i>now</i><par n="every__adv"/></e>
    <e lm="not"><i>not</i><par n="every__adv"/></e>
    <e lm="no"><i>no</i><par n="every__adv"/></e>
    <e lm="yes"><i>yes</i><par n="every__adv"/></e>
    <e lm="early"><i>early</i><par n="every__adv"/></e>
    <e lm="how"><i>how</i><par n="every__adv"/></e>
    <e lm="much"><i>much</i><par n="every__adv"/></e>
    <e lm="many"><i>many</i><par n="every__adv"/></e>

    <!-- Auxiliary Verbs -->
    <e lm="will"><i>will</i><par n="will__vaux"/></e>

    <!-- Conjunctions -->
    <e lm="and"><i>and</i><par n="and__cnjcoo"/></e>

    <!-- Nouns -->
    <e lm="afternoon"><i>afternoon</i><par n="house__n"/></e>
    <e lm="answer"><i>answer</i><par n="house__n"/></e>
    <e lm="bag"><i>bag</i><par n="house__n"/></e>
    <e lm="bed"><i>bed</i><par n="house__n"/></e>
